# Runtime environment labels. Confirmed rule: local/preview app builds must not
# connect to a production-labelled Supabase backend.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_ENV=local

# Supabase project values. Required before live Supabase execution/testing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=

# GitHub handoff values. Required before repo creation/connection.
GITHUB_OWNER=
GITHUB_REPOSITORY=

# Vercel handoff values. Required before preview/production deployment.
VERCEL_TEAM=
VERCEL_PROJECT=
VERCEL_PRODUCTION_DOMAIN=
NEXT_PUBLIC_SITE_URL=
