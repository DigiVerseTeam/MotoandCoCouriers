{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-preflight/types/**/*.ts",
    ".next-preflight/dev/types/**/*.ts",
    ".next-preflight-build/types/**/*.ts",
    ".next-preflight-build/dev/types/**/*.ts",
    ".next-preflight-build-runclose/types/**/*.ts",
    ".next-preflight-build-runclose/dev/types/**/*.ts",
    ".next-preflight-build-policy12/types/**/*.ts",
    ".next-preflight-build-policy12/dev/types/**/*.ts",
    ".next-preflight-build-assignmentfixture/types/**/*.ts",
    ".next-preflight-build-assignmentfixture/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "hcm-extract"
  ]
}
